# =================================================================
# NGINX — SPA ANGULAR EM CONTAINER (nginx-unprivileged, porta 8080)
# =================================================================
# Renderizado no start do container pelo envsubst da imagem oficial:
# /etc/nginx/templates/app.conf.template → /etc/nginx/conf.d/app.conf
# Só variáveis de ambiente DEFINIDAS são substituídas (defaults no Dockerfile
# gerado pelo template-ci); $uri, $host etc. continuam sendo variáveis do nginx.
#
# TLS fica no Ingress (Traefik + cert-manager) — aqui é só HTTP interno ao cluster.
# Configuração por ambiente: ConfigMap/env do Deployment → /config.json e CSP.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 50M;

    # =============================================================
    # HARDENING CONTRA PATH TRAVERSAL
    # =============================================================

    # 1. Truncamento / Null Byte
    if ($request_uri ~* "(%00|\x00)") {
        return 400;
    }

    # 2. Barras duplas ou dois-pontos na URI
    if ($request_uri ~* "(:|//)") {
        return 400;
    }

    # 3. Path traversal padrão e com pontos repetidos (.., ..., ....)
    if ($request_uri ~* "(\.\.|/(\.){2,}/|\\(\.){2,}\\)") {
        return 400;
    }

    # 4. Codificações hex, URL-encoded, UTF-8 overlong e unicode traversal
    if ($request_uri ~* "(%2e|%5c|%c0|%80|%u[0-9a-f]{4})") {
        return 400;
    }

    # 5. Alvos clássicos de LFI — evita que o fallback do SPA responda 200 pra eles
    if ($request_uri ~* "(win\.ini|boot\.ini|etc/passwd|web\.xml|\.htaccess|\.env)") {
        return 400;
    }

    # 6. Arquivos e diretórios ocultos
    location ~ /\.(?!well-known).* {
        deny all;
        access_log off;
        log_not_found off;
    }

    # 7. Extensões que não existem num SPA
    location ~* \.(ini|conf|config|bak|old|sql|sh|inc|cfg|log|cgi|pl|asp|aspx|jsp|do|action)$ {
        return 404;
    }

    # -------------------------------------------------------------
    # CABEÇALHOS DE SEGURANÇA
    # -------------------------------------------------------------
    # add_header num location descarta os do nível de cima, por isso o mesmo
    # include é repetido em cada location que declara header próprio.
    include /etc/nginx/conf.d/security-headers.inc;

    # -------------------------------------------------------------
    # HEALTHCHECK (probes do Kubernetes e smoke-test do pipeline)
    # -------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # -------------------------------------------------------------
    # CONFIGURAÇÃO EM RUNTIME — a mesma imagem serve qa/hml/prod
    # -------------------------------------------------------------
    # A app lê /config.json no bootstrap (APP_INITIALIZER / provideAppInitializer).
    location = /config.json {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store" always;
        default_type application/json;
        return 200 '${APP_RUNTIME_CONFIG}';
    }

    # -------------------------------------------------------------
    # ROTEAMENTO ANGULAR SPA
    # -------------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # -------------------------------------------------------------
    # CONTROLE DE CACHE — INDEX.HTML
    # -------------------------------------------------------------
    location = /index.html {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
    }

    # -------------------------------------------------------------
    # CACHE DE ARQUIVOS ESTÁTICOS COM HASH
    # -------------------------------------------------------------
    location ~* \.(?:css|js|woff2?|svg|ttf|eot|ico|png|jpg|jpeg|webp)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location = /csp-report {
        access_log off;
        return 204;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # -------------------------------------------------------------
    # COMPRESSÃO GZIP
    # -------------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        text/xml
        application/xml
        application/xml+rss
        text/javascript
        image/svg+xml;
}
